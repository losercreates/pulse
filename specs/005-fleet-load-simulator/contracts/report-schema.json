{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimulationReport",
  "type": "object",
  "required": [
    "timestamp",
    "config",
    "results",
    "sla_verdict"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "config": {
      "type": "object",
      "required": ["target_rate", "num_devices", "duration_seconds", "transport", "profile"],
      "properties": {
        "target_rate": { "type": "integer", "minimum": 1 },
        "num_devices": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "number", "minimum": 1 },
        "transport": { "type": "string", "enum": ["grpc", "http"] },
        "profile": { "type": "string", "enum": ["steady", "burst", "offline", "anomaly", "mixed"] }
      }
    },
    "results": {
      "type": "object",
      "required": [
        "total_sent",
        "total_failed",
        "error_rate_pct",
        "achieved_rate",
        "peak_rate"
      ],
      "properties": {
        "total_sent": { "type": "integer", "minimum": 0 },
        "total_failed": { "type": "integer", "minimum": 0 },
        "error_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "achieved_rate": { "type": "number", "minimum": 0 },
        "peak_rate": { "type": "number", "minimum": 0 },
        "canary_probes_sent": { "type": "integer", "minimum": 0 },
        "canary_probes_resolved": { "type": "integer", "minimum": 0 },
        "canary_p50_latency_ms": { "type": "number", "minimum": 0 },
        "canary_p95_latency_ms": { "type": "number", "minimum": 0 }
      }
    },
    "sla_verdict": {
      "type": "object",
      "required": [
        "compliant",
        "throughput_sla_met",
        "latency_sla_met",
        "error_sla_met",
        "violations"
      ],
      "properties": {
        "compliant": { "type": "boolean" },
        "throughput_sla_met": { "type": "boolean" },
        "latency_sla_met": { "type": "boolean" },
        "error_sla_met": { "type": "boolean" },
        "violations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
