      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "exponent": 0.5,
          "fill": "dark-orange",
          "mode": "scheme",
          "scheme": "Spectral"
        },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
