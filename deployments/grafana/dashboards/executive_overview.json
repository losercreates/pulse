  "panels": [
    {
      "id": 1,
      "title": "Total Ingestion Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20000 },
              { "color": "green", "value": 45000 }
            ]
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(pulse_ingest_records_total[30s]))",
          "legendFormat": "Ingestion Rate",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Canary p95 Latency SLA (<2.0s)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "max": 3000,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1800 },
              { "color": "red", "value": 2000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "pulse_canary_p95_latency_ms",
          "legendFormat": "Canary p95 Latency",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ingestion Error Rate (<0.10% SLA)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.10 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "(((sum(rate(pulse_ingest_clock_skew_rejected_total[1m])) + sum(rate(pulse_ingest_malformed_payloads_total[1m]))) / (sum(rate(pulse_ingest_records_total[1m])) + 0.001)) * 100)",
          "legendFormat": "Error Rate",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Incidents",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum(pulse_alert_active_firing_total)",
          "legendFormat": "Active Firing Alerts",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "End-to-End Pipeline Volume",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(pulse_ingest_records_total[1m]))",
          "legendFormat": "Gateway Ingested (records/sec)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(pulse_stream_events_processed_total[1m]))",
          "legendFormat": "Stream Processor (events/sec)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(pulse_storage_writes_total[1m]))",
