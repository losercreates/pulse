{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Storage Shards & Capacity",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "pulse_storage_active_shards_total",
          "legendFormat": "Active Shards (Fixed 16)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "pulse_storage_stored_records_total",
          "legendFormat": "Total Stored Records",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Aggregate Storage Write Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum by (status) (rate(pulse_storage_writes_total[30s]))",
          "legendFormat": "Status: {{ status }}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Batch Upsert Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(pulse_storage_batch_write_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 Latency",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(pulse_storage_batch_write_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(pulse_storage_batch_write_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Latency",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Historical Query Latency Heatmap",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "exponent": 0.5,
          "fill": "dark-orange",
          "mode": "scheme",
          "scheme": "Spectral"
        },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "yAxis": { "unit": "s" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(pulse_storage_query_latency_seconds_bucket[1m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{ le }}",
          "range": true,
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["pulse", "chronodb", "storage", "queries"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ChronoDB Storage & Analytical Query Engine",
  "uid": "pulse-chronodb-storage",
  "version": 1
}
