{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Real-Time Anomaly Detection Rate by Severity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "cps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "critical" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warning" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum by (severity) (rate(pulse_anomaly_detections_total[30s]))",
          "legendFormat": "{{ severity }}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Circuit Breaker State Timeline",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "green", "index": 0, "text": "CLOSED" },
                "1": { "color": "red", "index": 1, "text": "OPEN" },
                "2": { "color": "yellow", "index": 2, "text": "HALF_OPEN" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "always",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "pulse_alert_circuit_breaker_state",
          "legendFormat": "Sink: {{ sink }}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Downstream Webhook Dispatch Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(pulse_alert_dispatch_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 Latency",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(pulse_alert_dispatch_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(pulse_alert_dispatch_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Latency",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Alert Dispatches & Retries by Sink",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum by (sink, status) (rate(pulse_alert_dispatched_total[1m]))",
          "legendFormat": "Dispatched: {{ sink }} ({{ status }})",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pulse-prometheus" },
          "editorMode": "code",
          "expr": "sum by (sink) (rate(pulse_alert_retries_total[1m]))",
          "legendFormat": "Retries: {{ sink }}",
          "range": true,
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["pulse", "alerts", "anomalies", "circuit-breaker"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Anomaly Detection & Decoupled Alerting",
  "uid": "pulse-anomaly-alerts",
  "version": 1
}
